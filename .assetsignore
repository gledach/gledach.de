# Files in this directory that are not the website.
# Same format as .gitignore. Wrangler will not upload anything matching.

# Repository documentation and tooling.
README.md
CLAUDE.md
LICENSE
.gitignore
.assetsignore
wrangler.jsonc

# The design system is held outside the repository, but it does sit in this
# directory on a maintainer's machine. Deploying from there must not publish it.
DESIGN.md

# Design prototypes. Three candidate redesigns of the index, each a
# self-contained file. Work in progress, not part of the site.
prototypes

# The working notes vault. Gitignored today, so a git-driven build never sees
# it, but this is the belt to that braces: a local `wrangler deploy` uploads
# the working directory, and anyone who later decides to track the vault would
# otherwise publish it at gledach.de/.apsolut/.
.apsolut

# Social card sources. These render to assets/img/og-home.png and
# apple-touch-icon.png, both of which ARE deployed. The templates are the
# negatives, not the prints.
assets/og

# Never.
**/.git
**/node_modules
**/.wrangler
**/.DS_Store
**/Thumbs.db

# Deliberately NOT ignored, because they are part of the site:
#   index.md     the markdown twin, linked from the footer
#   llms.txt     the agent-readable summary
#   robots.txt   points crawlers at both of the above
#   sitemap.xml
#   favicon.svg and apple-touch-icon.png
#   assets/img/   including the rendered og-home.png
